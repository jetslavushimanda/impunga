rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} and skillProfiles/{uid} — single doc per user, keyed
    // directly by the user's own auth uid (not a `userId` field).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /skillProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // All user-owned app-data collections share the same shape:
    // every document carries a `userId` field set to its owner's auth uid.
    // Reads/updates/deletes are only allowed on documents you own; creates
    // are only allowed when the document being created is stamped with your
    // own uid (prevents writing data owned by someone else).
    //
    // 'skillProfiles' is listed here too even though it's also matched
    // above by uid: DataPrivacy.jsx's getUserDocumentCount() runs a
    // collection *query* filtered on the userId field rather than a
    // direct by-ID read, and Firestore can't reconcile a field-filtered
    // query against a doc-ID-keyed rule — it needs its own field-based
    // grant. Firestore ORs all matching rules, so both access patterns
    // (by-ID and by-query) are covered for that collection.
    match /{collection}/{docId} {
      allow read, update, delete: if collection in [
          'businessIdeas', 'businessPlans', 'savedNames',
          'monthlyReports', 'milestones', 'goals',
          'pricingCalculations', 'sales', 'expenses', 'debtors',
          'swotAnalyses', 'bookmarkedFunding', 'skillProfiles'
        ]
        && request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if collection in [
          'businessIdeas', 'businessPlans', 'savedNames',
          'monthlyReports', 'milestones', 'goals',
          'pricingCalculations', 'sales', 'expenses', 'debtors',
          'swotAnalyses', 'bookmarkedFunding', 'skillProfiles'
        ]
        && request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // Everything else: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
